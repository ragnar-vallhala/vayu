#
# vayu kernel configuration (vaios Kconfig defconfig).
#
# Replaces the old include/vaios_app_config.h: vaios 0.2.0 dropped the
# hand-written config header (VAIOS_CONFIG_FILE) for Kconfig, so the knobs now
# live here and reach the compiler through the generated vaios_autoconf.h.
#
# ONLY the values where vayu differs from a vaios default belong here. The other
# ~25 macros the old header carried were restating defaults, which meant a vaios
# default could change under us without the header showing a diff. An empty line
# here now means "whatever vaios ships", deliberately.
#
# Seeded into <build>/.config, which is what the build actually reads. The root
# CMakeLists drops a stale seed when this file is newer, so editing here is
# enough -- see the note beside VAIOS_DEFCONFIG.

# ~45 KiB/s telemetry. Raised from 230400 (the old ESP8266 cap); the bridge now
# has a 4 KiB RX ring to absorb WiFi-TX stalls at this rate. The ESP's FC_BAUD
# must match. See firmware/docs/plans/link-bandwidth-boost.md.
CONFIG_CONSOLE_BAUDRATE=460800

# 40 KiB. vaios defaults this to 0x16000 (88 KiB), which does not fit: the kernel
# memsets HEAP_SIZE bytes from _heap_start at boot under the hard constraint
#     _heap_start + HEAP_SIZE <= 0x20018000   (top of the F401's 96 KiB SRAM)
# and overrunning it HardFaults before main(). Holds the boot task stacks + IPC
# (~18.6 KiB) plus the heaviest post-boot allocation, the calibration task's
# 8 KiB stack v_malloc'd on CMD_CALIBRATE_IMU, leaving ~21 KiB free.
#
# The host SITL has no 96 KiB limit and needs room for many 8 KiB task stacks,
# so it passes -DHEAP_SIZE=0x180000; the generated macros are #ifndef-guarded,
# so that -D still wins over this.
CONFIG_HEAP_SIZE=0xA000

# Boot/main stack, well above the 1 KiB default: main() runs the whole
# composition root (driver init, calibration load, task spawn) before the
# scheduler takes over.
CONFIG_MAIN_STACK_SIZE=10240

# 256 B of headroom rather than 64. rate_ctl measured 856 B of an 1536 B stack,
# and a stack overflow on this part corrupts whatever BSS sits below it.
CONFIG_TASK_STACK_OVERFLOW_THRESHOLD=256

# The console is a NavLink byte stream, not a terminal: vaios logging would
# interleave framed packets with ASCII and desync every peer. Colour codes would
# do the same, so they stay off even with logging disabled.
# CONFIG_LOGGING_ENABLED is not set
# CONFIG_COLOR_LOGGING is not set

# Log sizing kept at vayu's historical values rather than vaios's larger
# defaults (96 B / 256 B): this is static BSS on a RAM-starved part.
CONFIG_LOG_MSG_MAX_LEN=64
CONFIG_LOG_BUFFER_STORAGE_SIZE=128

# vayu passed LOG_TRACE (enum value 0). vaios's Kconfig help labels 0 as DEBUG --
# its range is 0..3 while Log_Type runs TRACE..FATAL -- but 0 is the most verbose
# either way, which is what vayu asked for.
CONFIG_MIN_LOG_LEVEL=0
CONFIG_TERMINAL_LOG_LEVEL=0

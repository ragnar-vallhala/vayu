# regenerable / bulky derived data
csv/
__pycache__/

# raw logs are ignored by default...
*.bin
# ...except the curated per-archive copies kept as source of truth
!*/export-*.bin
!*/gt-*.bin
# curated raw telemetry kept in an archive's data//freeflight/ subdir (any name).
# NB: do not use a subdir literally named "logs" — the repo-root .gitignore ignores it.
!*/data/*.bin
!*/freeflight/*.bin

# mermaid render intermediates for the PDF (regenerated by build_pdf.py)
**/plots/diagram_*.png
.pdf-header.tex
.pdf.css

# rendered PDFs are regenerable (build_pdf.py) — not committed
*-analysis.pdf

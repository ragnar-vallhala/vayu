/* -----------------------------------------------------------------
 * Vayu Navigator — dark theme
 *
 * Single source of truth for widget styling. Colour tokens are
 * mirrored in software/src/core/Theme.h; keep them in sync.
 *
 * Token reference (must equal Theme.h):
 *   surfaces : #1A1D27 bg  · #21252B surface · #2C313A surfAlt · #13141B base
 *   borders  : #2A3347 hairline · #3E4452 strong
 *   text     : #DCDFE4 text · #ABB2BF muted · #5C6370 dim
 *   accent   : #61AFEF · #98C379 ok · #D19A66 warn · #E06C75 danger
 *
 * Convention: per-widget colour overrides go through objectName
 * selectors below, NOT through ad-hoc setStyleSheet() calls in C++.
 * ----------------------------------------------------------------- */

/* ===== Generic surfaces ===== */
QMainWindow,
QDialog {
    background: #1A1D27;
    color: #DCDFE4;
}

QWidget {
    color: #DCDFE4;
}

QGroupBox {
    border: 1px solid #2A3347;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 6px;
    color: #7090C8;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QSplitter::handle { background: #2A3347; }

/* ===== Menus + toolbar ===== */
QMenuBar {
    background: #1A1D27;
    color: #ABB2BF;
    border-bottom: 1px solid #2A3347;
}
QMenuBar::item        { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #2A3347; color: #FFFFFF; }

QMenu {
    background: #21252B;
    color: #ABB2BF;
    border: 1px solid #3E4452;
}
QMenu::item             { padding: 4px 24px 4px 20px; }
QMenu::item:selected    { background: #3E4452; color: #FFFFFF; }

QToolBar {
    background: #1A1D27;
    border-bottom: 1px solid #2A3347;
    spacing: 6px;
}
QToolBar QLabel { color: #ABB2BF; }

/* ===== Status bar ===== */
QStatusBar {
    background: #1A1D27;
    color: #ABB2BF;
}

/* ===== Inputs ===== */
QComboBox,
QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background: #21252B;
    color: #ABB2BF;
    border: 1px solid #3E4452;
    padding: 2px 6px;
    border-radius: 4px;
    min-width: 110px;
}
QComboBox:focus,
QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #61AFEF;
}

/* ===== Buttons ===== */
/* Default chrome — used by raw QPushButton too. */
QPushButton {
    background: #2C313A;
    color: #ABB2BF;
    border: 1px solid #3E4452;
    padding: 4px 14px;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton:hover    { background: #3E4452; }
QPushButton:pressed  { background: #4B5263; }
QPushButton:disabled {
    color: #4A4A4A;
    border-color: #2A2A2A;
    background: #252525;
}

/* Primary / accent — blue. Use via PrimaryButton subclass. */
QPushButton#PrimaryButton {
    background: #3A5F8F;
    color: #DCDFE4;
    border: 1px solid #61AFEF;
}
QPushButton#PrimaryButton:hover    { background: #4A77AA; }
QPushButton#PrimaryButton:pressed  { background: #2F4F75; }

/* Success / connect — green. Use via SuccessButton subclass. */
QPushButton#SuccessButton {
    background: #3A5F3A;
    color: #98C379;
    border: 1px solid #5A8F5A;
}
QPushButton#SuccessButton:hover   { background: #4A7A4A; }
QPushButton#SuccessButton:pressed { background: #2F4F2F; }

/* Danger / arm / disconnect — red. Use via DangerButton subclass. */
QPushButton#DangerButton {
    background: #5A3A3A;
    color: #E06C75;
    border: 1px solid #8F5A5A;
}
QPushButton#DangerButton:hover    { background: #7A4A4A; }
QPushButton#DangerButton:pressed  { background: #4F2F2F; }
QPushButton#DangerButton:checked  {
    background: #8F5A5A;
    color: #FF8888;
}

/* Ghost / quiet action — flat with subtle border. */
QPushButton#GhostButton {
    background: #3E4452;
    color: #DCDFE4;
    border: 1px solid #3E4452;
}
QPushButton#GhostButton:hover   { background: #4F5662; }
QPushButton#GhostButton:pressed { background: #353A45; }

/* Disabled state for the coloured subclasses. The #Id selectors above
 * outrank the generic `QPushButton:disabled` rule, so without these an
 * enabled-looking green/red button would stay green/red when disabled.
 * Repeat the muted look here so setEnabled(false) actually greys out. */
QPushButton#PrimaryButton:disabled,
QPushButton#SuccessButton:disabled,
QPushButton#DangerButton:disabled,
QPushButton#GhostButton:disabled {
    background: #252525;
    color: #4A4A4A;
    border: 1px solid #2A2A2A;
}

/* Back / nav — same as Ghost, with a smaller footprint. */
QPushButton#BackButton {
    background: #3E4452;
    color: #ABB2BF;
    padding: 6px 12px;
}
QPushButton#BackButton:hover { background: #4F5662; }

/* Small toggle (3D-view switcher etc.) — accent fill when :checked. */
QPushButton#ToggleButton {
    background: #2C313A;
    color: #ABB2BF;
    border: 1px solid #3E4452;
    border-radius: 4px;
    font-weight: bold;
    font-size: 10px;
}
QPushButton#ToggleButton:checked {
    background: #61AFEF;
    color: #21252B;
}

/* Big checkable card — sensor selection on the calibration page. */
QPushButton#SensorCard {
    background: #21252B;
    color: #ABB2BF;
    border: 2px solid #3E4452;
    border-radius: 8px;
    font-weight: bold;
    min-height: 80px;
}
QPushButton#SensorCard:hover:!checked { background: #2C313C; }
QPushButton#SensorCard:checked {
    background: #2C313C;
    color: #61AFEF;
    border-color: #61AFEF;
}

/* Filter pill — checkable, fills accent when :checked. Used for
 * per-packet-type filtering on the analyzer page. */
QPushButton#FilterPill {
    background: #2A3347;
    color: #ABB2BF;
    border: 1px solid #3E4452;
    border-radius: 4px;
    padding: 2px 10px;
}
QPushButton#FilterPill:checked {
    background: #61AFEF;
    color: #1A1D27;
    font-weight: bold;
    border-color: #61AFEF;
}

/* ===== Toolbar brand label ===== */
QLabel#BrandLabel {
    color: #61AFEF;
    font-size: 16px;
    padding: 0 8px;
}

/* ===== LIVE blinker + sync drift pills (default idle state) ===== */
QLabel#LiveBlinker {
    background: #1A1D27;
    color: #4B5263;
    border-radius: 4px;
    font-weight: bold;
    padding: 2px 8px;
    border: 1px solid #2A3347;
}

/* ===== Tabs ===== */
QTabWidget::pane {
    border: 1px solid #2A3347;
    background: #1A1D27;
}
QTabBar::tab {
    background: #21252B;
    color: #ABB2BF;
    padding: 6px 14px;
    border: 1px solid #2A3347;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: #2C313A;
    color: #DCDFE4;
}

/* ===== Scrollbars ===== */
QScrollBar:vertical {
    background: #1A1D27;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3E4452;
    min-height: 30px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover { background: #4F5662; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #1A1D27;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3E4452;
    min-width: 30px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover { background: #4F5662; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }

/* ===== Tables, trees, lists ===== */
QTableWidget,
QTreeWidget,
QListWidget {
    background: #1E212B;
    color: #ABB2BF;
    border: 1px solid #2A3347;
    gridline-color: #2A3347;
    selection-background-color: #2C5A8A;
    selection-color: #FFFFFF;
}
QHeaderView::section {
    background: #2C313A;
    color: #DCDFE4;
    padding: 4px 8px;
    border: 1px solid #2A3347;
}

/* ===== Plain text editor (logs) ===== */
QPlainTextEdit,
QTextEdit {
    background: #13141B;
    color: #A3BE8C;
    font-family: "Monospace";
    font-size: 11px;
    border: 1px solid #2A3347;
    border-radius: 3px;
}

/* ===== Progress bar ===== */
QProgressBar {
    background: #21252B;
    border: 1px solid #2A3347;
    border-radius: 3px;
    text-align: center;
    color: #DCDFE4;
}
QProgressBar::chunk {
    background: #61AFEF;
    border-radius: 2px;
}

/* ===== Radio + checkbox ===== */
QRadioButton, QCheckBox {
    color: #ABB2BF;
    spacing: 6px;
}

/* ===== Tooltip ===== */
QToolTip {
    background: #2C313A;
    color: #DCDFE4;
    border: 1px solid #3E4452;
    padding: 4px 6px;
}

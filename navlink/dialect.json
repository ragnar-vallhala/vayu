        { "name": "SIGN",    "value": 2 },
        { "name": "ENCRYPT", "value": 4 }
      ]
    },
    "nav_state": {
      "doc": "HEARTBEAT.nav_state. Sequential v2 encoding of the firmware flight-state machine.",
      "entries": [
        { "name": "UNINITIALIZED", "value": 0 },
        { "name": "INIT",          "value": 1 },
        { "name": "STANDBY",       "value": 2 },
        { "name": "PREARM",        "value": 3 },
        { "name": "ARMED",         "value": 4 },
        { "name": "IN_AIR",        "value": 5 },
        { "name": "FAILSAFE",      "value": 6 },
        { "name": "TERMINATED",    "value": 7 },
        { "name": "CALIBRATING",   "value": 8 }
      ]
    },
    "flight_mode": {
      "doc": "FLIGHT_MODE.mode / CMD_SET_FLIGHT_MODE.mode.",
      "entries": [
        { "name": "ANGLE",         "value": 0 },
        { "name": "ACRO",          "value": 1 },
        { "name": "RELEASE_TO_RC", "value": 2 }
      ]
    },
    "mode_source": {
      "doc": "Who selected the active flight mode.",
      "entries": [
        { "name": "RC",  "value": 0 },
        { "name": "GCS", "value": 1 }
      ]
    },
    "pid_controller": {

        { "name": "RATE",  "value": 1 }
      ]
    },
    "pid_axis": {
      "doc": "CMD_SET_PID.axis / CMD_SET_GYRO_LPF.axis.",
      "entries": [
        { "name": "ROLL",  "value": 0 },
        { "name": "PITCH", "value": 1 },
        { "name": "YAW",   "value": 2 }
      ]
    },
    "severity": {
      "doc": "STATUSTEXT.severity (syslog-style).",
      "entries": [
        { "name": "EMERGENCY", "value": 0 }, { "name": "ALERT",  "value": 1 },
        { "name": "CRITICAL",  "value": 2 }, { "name": "ERROR",  "value": 3 },
        { "name": "WARNING",   "value": 4 }, { "name": "NOTICE", "value": 5 },
        { "name": "INFO",      "value": 6 }, { "name": "DEBUG",  "value": 7 }
      ]
    },
    "calib_step": {
      "doc": "CALIBRATION_STATUS.step — progress update or operator instruction (spec §14.8).",
      "entries": [
        { "name": "PROGRESS",          "value": 0 },
        { "name": "NOSE_UP",           "value": 1 },
        { "name": "NOSE_DOWN",         "value": 2 },
        { "name": "RIGHT_DOWN",        "value": 3 },
        { "name": "LEFT_DOWN",         "value": 4 },
        { "name": "UPRIGHT",           "value": 5 },
        { "name": "UPSIDE_DOWN",       "value": 6 },
        { "name": "FREE_ROT",          "value": 7 },
        { "name": "MAG_AXIS_COVERAGE", "value": 8 }
      ]
    },
    "perf_fifo_id": {
      "doc": "PERF_FIFO.fifo_id — stable ids so rows label regardless of send order (spec §14.8).",
      "entries": [
        { "name": "IMU_RAW",            "value": 0 },
        { "name": "IMU_TELEMETRY",      "value": 1 },
        { "name": "IMU_CONTROL",        "value": 2 },
        { "name": "IMU_CALIB",          "value": 3 },
        { "name": "IMU_CALIB_TELEM",    "value": 4 },
        { "name": "ATTITUDE_TELEMETRY", "value": 5 },
        { "name": "ATTITUDE_CONTROL",   "value": 6 },
        { "name": "RC_TELEMETRY",       "value": 7 },
        { "name": "RC_CONTROL",         "value": 8 },
        { "name": "TELEMETRY",          "value": 9 }
      ]
    }
  },

  "messages": [
    {
      "msgid": 0, "name": "HEARTBEAT", "replaces": "0x0",
      "doc": "~1 Hz liveness, mode, advertised capabilities, wall-clock stamp.",
      "fields": [
        { "index": 0, "name": "type",          "type": "u8",  "doc": "vehicle type" },
        { "index": 1, "name": "autopilot",     "type": "u8" },
        { "index": 2, "name": "base_mode",     "type": "u8" },
        { "index": 3, "name": "system_status", "type": "u8" },
        { "index": 4, "name": "nav_state",     "type": "u8",  "enum": "nav_state" },
        { "index": 5, "name": "capabilities",  "type": "u32", "doc": "capability bitmask (spec §13)" },
        { "index": 6, "name": "timestamp",     "type": "u32", "doc": "wall-clock [s:20|ms:12] (spec §6.1)" }
      ]
    },
    {
      "msgid": 2, "name": "SYSTEM_HEALTH", "replaces": "0x6/0x02",
      "doc": "Firmware health counters. v1: SYSTEM_STATUS origin HEALTH.",
      "fields": [
        { "index": 0, "name": "tx_overflow", "type": "u32" },
        { "index": 1, "name": "imu_drop",    "type": "u32" },
        { "index": 2, "name": "log_wrap",    "type": "u32" },
        { "index": 3, "name": "cpu_load",    "type": "u8", "unit": "%" }
      ]
    },
    {
      "msgid": 3, "name": "FLIGHT_MODE", "replaces": "0x6/0x07",
      "doc": "Active flight mode and who selected it. v1: SYSTEM_STATUS origin FLIGHT_MODE.",
      "fields": [
        { "index": 0, "name": "mode",   "type": "u8", "enum": "flight_mode" },
        { "index": 1, "name": "source", "type": "u8", "enum": "mode_source" }
      ]
    },
    {
      "msgid": 4, "name": "STATUSTEXT", "replaces": "0x7",
      "doc": "Human-readable status/log line. v1: PACKET_TYPE_LOG.",
      "fields": [
        { "index": 0, "name": "severity",  "type": "u8",   "enum": "severity" },
        { "index": 1, "name": "text",      "type": "char", "len": 50 },
        { "index": 2, "name": "id",        "type": "u16",  "doc": "groups multi-chunk messages" },
        { "index": 3, "name": "chunk_seq", "type": "u8" }
      ]
    },
    {
      "msgid": 5, "name": "COMMAND_ACK", "replaces": "0x3 (ack)",
      "doc": "Acknowledges any command, correlated by (command, req_seq).",
      "fields": [
        { "index": 0, "name": "command",       "type": "u24", "doc": "acked command's msgid" },
        { "index": 1, "name": "req_seq",       "type": "u8" },
        { "index": 2, "name": "result",        "type": "u8",  "enum": "command_result" },
        { "index": 3, "name": "progress",      "type": "u8",  "doc": "0..100 for IN_PROGRESS" },
        { "index": 4, "name": "result_param2", "type": "i32" }
      ]
    },
    {
      "msgid": 8, "name": "PING",
      "doc": "Round-trip liveness probe.",
      "fields": [
        { "index": 0, "name": "seq",    "type": "u32" },
        { "index": 1, "name": "target", "type": "u8" }
      ]
    },
    {
      "msgid": 9, "name": "CAPABILITIES",
      "doc": "Full capability list, on request at connect (spec §13). msgid_ranges omitted in this cut.",
      "fields": [
        { "index": 0, "name": "protocol_version",   "type": "u8" },
        { "index": 1, "name": "sec_modes",          "type": "u8",  "doc": "sec_mode bitmask" },
        { "index": 2, "name": "_pad",               "type": "u16" },
        { "index": 3, "name": "incompat_supported", "type": "u32", "doc": "incompat bits this peer implements" },
        { "index": 4, "name": "key_id",             "type": "u32", "doc": "non-secret shared-key id (spec §11.7)" }
      ]
    },
    {
      "msgid": 10, "name": "TIME_SYNC",
      "doc": "NTP-style FC<->GCS clock sync (spec §10). The GCS sends role=REQUEST stamping t1_gcs_tx; the FC replies role=RESPONSE echoing t1 and adding t2_fc_rx (its receive time) and t3_fc_tx (its send time). The GCS captures t4 locally on receipt and computes offset=((t2-t1)+(t3-t4))/2, delay=(t4-t1)-(t3-t2). commanded_offset_ms carries the GCS's filtered correction back to the FC (INT32_MIN = none). Byte-identical to the firmware time_sync_payload_t; all stamps are milliseconds (32 B).",
      "fields": [
        { "index": 0, "name": "role",                "type": "u8",  "enum": "time_sync_role" },
        { "index": 1, "name": "seq",                 "type": "u8",  "doc": "request sequence, echoed in the response" },
        { "index": 2, "name": "_pad",                "type": "u8",  "len": 2, "doc": "reserved, zero" },
        { "index": 3, "name": "t1_gcs_tx",           "type": "u64", "unit": "ms", "doc": "GCS send (wall-clock ms)" },
        { "index": 4, "name": "t2_fc_rx",            "type": "u64", "unit": "ms", "doc": "FC receive (FC ms)" },
        { "index": 5, "name": "t3_fc_tx",            "type": "u64", "unit": "ms", "doc": "FC send (FC ms)" },
        { "index": 6, "name": "commanded_offset_ms", "type": "i32", "doc": "GCS->FC correction; INT32_MIN = none" }
      ]
    },

    {
      "msgid": 1024, "name": "IMU_RAW", "replaces": "0x1",
      "doc": "Full IMU snapshot. v1: PACKET_TYPE_IMU_DATA_FULL (10×f32).",
      "fields": [
        { "index": 0, "name": "acc",            "type": "f32", "len": 3, "unit": "m/s/s" },
        { "index": 1, "name": "gyr",            "type": "f32", "len": 3, "unit": "deg/s" },
        { "index": 2, "name": "mag",            "type": "f32", "len": 3, "unit": "uT" },
        { "index": 3, "name": "temp",           "type": "f32", "unit": "degC" },
        { "index": 4, "name": "sample_time_us", "type": "u32", "unit": "us", "extension": true,
          "doc": "added in v2; old peers ignore it (spec §5.5)" }
      ]
    },
    {
      "msgid": 1025, "name": "IMU_COMPRESSED", "replaces": "0x2",
      "doc": "Delta IMU vs last IMU_RAW. v1: PACKET_TYPE_IMU_DATA_COMPRESSED (10×f16). NOTE: NavLink has no f16 type (spec §5.1); the 10 half-float bit patterns are carried as u16 and decoded by the application.",
      "fields": [
        { "index": 0, "name": "ref_seq", "type": "u8",  "doc": "seq of the IMU_RAW this deltas against" },
        { "index": 1, "name": "_pad",    "type": "u8" },
        { "index": 2, "name": "delta",   "type": "u16", "len": 10, "doc": "IEEE-754 binary16 deltas: acc[3],gyr[3],mag[3],temp" }
      ]
    },
    {
      "msgid": 1026, "name": "ATTITUDE_EULER", "replaces": "0x4",
      "doc": "Euler attitude + body rates, NED frame.",
      "fields": [
        { "index": 0, "name": "roll",       "type": "f32", "unit": "rad" },
        { "index": 1, "name": "pitch",      "type": "f32", "unit": "rad" },
        { "index": 2, "name": "yaw",        "type": "f32", "unit": "rad" },
        { "index": 3, "name": "rollspeed",  "type": "f32", "unit": "rad/s" },
        { "index": 4, "name": "pitchspeed", "type": "f32", "unit": "rad/s" },
        { "index": 5, "name": "yawspeed",   "type": "f32", "unit": "rad/s" }
      ]
    },
    {
      "msgid": 1028, "name": "RC_CHANNELS", "replaces": "0x5",
      "doc": "RC channel values. v1: PACKET_TYPE_RC_CHANNELS (14×u16); v2 widens to 18.",
      "fields": [
        { "index": 0, "name": "chan",  "type": "u16", "len": 18, "unit": "us" },
        { "index": 1, "name": "rssi",  "type": "u8" },
        { "index": 2, "name": "count", "type": "u8", "doc": "number of valid channels" }
      ]
    },
    {
      "msgid": 1029, "name": "MOTOR_TELEMETRY", "replaces": "0x8",
      "doc": "Per-motor output command. v1: PACKET_TYPE_MOTOR_TELEMETRY (4×f32); v2 allows up to 8.",
      "fields": [
        { "index": 0, "name": "cmd", "type": "f32", "len": 8, "doc": "normalised motor command; unused motors = 0" }
      ]
    },
    {
      "msgid": 1030, "name": "CONTROL_TRACE", "replaces": "0x6/0x05",
      "doc": "18×f32 PID/loop trace. v1: SYSTEM_STATUS origin PID_ERROR (control_telemetry_t).",
      "fields": [
        { "index": 0,  "name": "roll_angle_sp",   "type": "f32" },
        { "index": 1,  "name": "pitch_angle_sp",  "type": "f32" },
        { "index": 2,  "name": "yaw_angle_sp",    "type": "f32" },
        { "index": 3,  "name": "roll_angle_curr", "type": "f32" },
        { "index": 4,  "name": "pitch_angle_curr","type": "f32" },
        { "index": 5,  "name": "yaw_angle_curr",  "type": "f32" },
        { "index": 6,  "name": "roll_rate_sp",    "type": "f32" },
        { "index": 7,  "name": "pitch_rate_sp",   "type": "f32" },
        { "index": 8,  "name": "yaw_rate_sp",     "type": "f32" },
        { "index": 9,  "name": "roll_rate_curr",  "type": "f32" },
        { "index": 10, "name": "pitch_rate_curr", "type": "f32" },
        { "index": 11, "name": "yaw_rate_curr",   "type": "f32" },
        { "index": 12, "name": "roll_out",        "type": "f32" },
        { "index": 13, "name": "pitch_out",       "type": "f32" },
        { "index": 14, "name": "yaw_out",         "type": "f32" },
        { "index": 15, "name": "thro_out",        "type": "f32" },
        { "index": 16, "name": "outer_dt",        "type": "f32", "unit": "s" },
        { "index": 17, "name": "inner_dt",        "type": "f32", "unit": "s" }
      ]
    },
    {
      "msgid": 1033, "name": "EST_PERF", "replaces": "0x6/0x08",
      "doc": "Estimator loop timing. v1: SYSTEM_STATUS origin EST_PERF (spec §14.8).",
      "fields": [
        { "index": 0, "name": "peak_us",    "type": "f32", "unit": "us" },
        { "index": 1, "name": "mean_us",    "type": "f32", "unit": "us" },
        { "index": 2, "name": "decimation", "type": "f32" },
        { "index": 3, "name": "rate_hz",    "type": "f32", "unit": "Hz" }
      ]
    },
    {
      "msgid": 1034, "name": "PERF_GLOBAL", "replaces": "0x9 (GLOBAL)",
      "doc": "vaios PERF scheduler/ISR/IPC/heap snapshot. One per report; PERF_TASK/PERF_FIFO share `seq` (spec §14.8).",
      "fields": [
        { "index": 0,  "name": "seq",                 "type": "u32", "doc": "report id shared by all fragments" },
        { "index": 1,  "name": "flags",               "type": "u8",  "doc": "bit0 = PERF compiled-in & live" },
        { "index": 2,  "name": "total_tasks",         "type": "u8" },
        { "index": 3,  "name": "total_fifos",         "type": "u8" },
        { "index": 4,  "name": "_pad",                "type": "u8" },
        { "index": 5,  "name": "uptime_ticks",        "type": "u32" },
        { "index": 6,  "name": "sched_switches",      "type": "u32" },
        { "index": 7,  "name": "cpu_cycles_lo",       "type": "u32", "doc": "low 32 bits of 64-bit cycle counter" },
        { "index": 8,  "name": "idle_cycles_lo",      "type": "u32" },
        { "index": 9,  "name": "systick_count",       "type": "u32" },
        { "index": 10, "name": "systick_last_cyc",    "type": "u32" },
        { "index": 11, "name": "systick_max_cyc",     "type": "u32" },
        { "index": 12, "name": "systick_preemptions", "type": "u32" },
        { "index": 13, "name": "ipc_takes",           "type": "u32" },
        { "index": 14, "name": "ipc_takes_blocked",   "type": "u32" },
        { "index": 15, "name": "ipc_gives",           "type": "u32" },
        { "index": 16, "name": "ipc_timeouts",        "type": "u32" },
        { "index": 17, "name": "heap_allocs",         "type": "u32" },
        { "index": 18, "name": "heap_frees",          "type": "u32" },
        { "index": 19, "name": "heap_oom",            "type": "u32" },
        { "index": 20, "name": "heap_peak_bytes",     "type": "u32" },
        { "index": 21, "name": "heap_total_bytes",    "type": "u32" }
      ]
    },
    {
      "msgid": 1035, "name": "PERF_TASK", "replaces": "0x9 (TASKS row)",
      "doc": "One task row; `seq` ties it to a PERF_GLOBAL report. Collect total_tasks of these per seq (spec §14.8).",
      "fields": [
        { "index": 0, "name": "seq",           "type": "u32" },
        { "index": 1, "name": "task_id",       "type": "u8" },
        { "index": 2, "name": "priority",      "type": "u8" },
        { "index": 3, "name": "state",         "type": "u8",  "doc": "Task_Status" },
        { "index": 4, "name": "_pad",          "type": "u8" },
        { "index": 5, "name": "stack_peak",    "type": "u16", "unit": "B", "doc": "high-water bytes" },
        { "index": 6, "name": "stack_size",    "type": "u16", "unit": "B" },
        { "index": 7, "name": "cycles_lo",     "type": "u32", "doc": "low 32 bits of total cycles" },
        { "index": 8, "name": "switches_in",   "type": "u32" },
        { "index": 9, "name": "max_burst_cyc", "type": "u32" }
      ]
    },
    {
      "msgid": 1036, "name": "PERF_FIFO", "replaces": "0x9 (FIFOS row)",
      "doc": "One SPSC FIFO row; collect total_fifos per seq (spec §14.8).",
      "fields": [
        { "index": 0, "name": "seq",      "type": "u32" },
        { "index": 1, "name": "fifo_id",  "type": "u8",  "enum": "perf_fifo_id" },
        { "index": 2, "name": "_pad",     "type": "u8" },
        { "index": 3, "name": "peak",     "type": "u16", "doc": "high-water fill (elements)" },
        { "index": 4, "name": "capacity", "type": "u16", "doc": "usable capacity (elements)" },
        { "index": 5, "name": "drops",    "type": "u16", "doc": "items lost, saturating at 0xFFFF" }
      ]
    },
    {
      "msgid": 1037, "name": "PERF_TASKNAME_REQUEST",
      "doc": "GCS → FC: resolve one task id to its name (spec §14.8).",
      "fields": [
        { "index": 0, "name": "target_sys",  "type": "u8" },
        { "index": 1, "name": "target_comp", "type": "u8" },
        { "index": 2, "name": "task_id",     "type": "u8" }
      ]
    },
    {
      "msgid": 1038, "name": "PERF_TASKNAME",
      "doc": "FC → GCS reply; name is NUL-padded char[32] (PERF_TASKNAME_MAX) (spec §14.8).",
      "fields": [
        { "index": 0, "name": "task_id", "type": "u8" },
        { "index": 1, "name": "name",    "type": "char", "len": 32 }
      ]
    },

    {
      "msgid": 8192, "name": "CMD_ARM", "replaces": "0x3/cmd 0x0002",
      "doc": "Set the software-arm latch. Opens with the standard command header (spec §12.1).",
      "fields": [
        { "index": 0, "name": "target_sys",  "type": "u8" },
        { "index": 1, "name": "target_comp", "type": "u8" },
        { "index": 2, "name": "req_seq",     "type": "u8" },
        { "index": 3, "name": "force",       "type": "u8" }
      ]
    },
    {
      "msgid": 8193, "name": "CMD_DISARM", "replaces": "0x3/cmd 0x0003",
      "doc": "Clear the software-arm latch.",
      "fields": [
        { "index": 0, "name": "target_sys",  "type": "u8" },
        { "index": 1, "name": "target_comp", "type": "u8" },
        { "index": 2, "name": "req_seq",     "type": "u8" },
        { "index": 3, "name": "force",       "type": "u8" }
      ]
    },
    {
      "msgid": 8194, "name": "CMD_CALIBRATE_IMU", "replaces": "0x3/cmd 0x0001",
      "doc": "Start IMU calibration; progress streams back via CALIBRATION_STATUS.",
      "fields": [
        { "index": 0, "name": "target_sys",  "type": "u8" },
        { "index": 1, "name": "target_comp", "type": "u8" },
        { "index": 2, "name": "req_seq",     "type": "u8" },
        { "index": 3, "name": "which",       "type": "u8", "doc": "which IMU/calibration routine" }
      ]
    },
    {
      "msgid": 8195, "name": "CMD_SET_PID", "replaces": "0x3/cmd 0x000A",
      "doc": "Set a PID gain set. v1 carries controller+axis+kp+ki+kd+kff.",
      "fields": [
        { "index": 0, "name": "target_sys",  "type": "u8" },
        { "index": 1, "name": "target_comp", "type": "u8" },
        { "index": 2, "name": "req_seq",     "type": "u8" },
        { "index": 3, "name": "controller",  "type": "u8", "enum": "pid_controller" },
        { "index": 4, "name": "axis",        "type": "u8", "enum": "pid_axis" },
        { "index": 5, "name": "kp",          "type": "f32" },
        { "index": 6, "name": "ki",          "type": "f32" },
        { "index": 7, "name": "kd",          "type": "f32" },
        { "index": 8, "name": "kff",         "type": "f32" }
      ]
    },
    {
      "msgid": 8196, "name": "CMD_SET_GYRO_LPF", "replaces": "0x3/cmd 0x000B",
      "doc": "Set rate-loop gyro low-pass time constant per axis. v1: rc (seconds); <=0 disables.",
      "fields": [
        { "index": 0, "name": "target_sys",  "type": "u8" },
        { "index": 1, "name": "target_comp", "type": "u8" },
        { "index": 2, "name": "req_seq",     "type": "u8" },
        { "index": 3, "name": "axis",        "type": "u8", "enum": "pid_axis" },
        { "index": 4, "name": "rc",          "type": "f32", "unit": "s", "doc": "time constant; <=0 = off" }
      ]
    },
    {
      "msgid": 8197, "name": "CMD_SET_MOTOR_GEOMETRY", "replaces": "0x3/cmd 0x000C",
      "doc": "Reconfigure the 4-motor mixer from per-motor position and spin direction.",
      "fields": [
        { "index": 0, "name": "target_sys",  "type": "u8" },
        { "index": 1, "name": "target_comp", "type": "u8" },
        { "index": 2, "name": "req_seq",     "type": "u8" },
        { "index": 3, "name": "layout",      "type": "u8" },
        { "index": 4, "name": "pos_x",       "type": "f32", "len": 4 },
        { "index": 5, "name": "pos_y",       "type": "f32", "len": 4 },
        { "index": 6, "name": "spin",        "type": "i8",  "len": 4, "doc": "+1 / -1 per motor" }
      ]
    },
    {
      "msgid": 8198, "name": "CMD_SET_FLIGHT_MODE", "replaces": "0x3/cmd 0x000D",
      "doc": "Override the flight mode (sticky GCS control, or release back to RC).",
      "fields": [
        { "index": 0, "name": "target_sys",  "type": "u8" },
        { "index": 1, "name": "target_comp", "type": "u8" },
        { "index": 2, "name": "req_seq",     "type": "u8" },
        { "index": 3, "name": "mode",        "type": "u8", "enum": "flight_mode" },
        { "index": 4, "name": "source",      "type": "u8", "enum": "mode_source" }
      ]
    },

    {
      "msgid": 12288, "name": "PARAM_REQUEST_LIST",
      "doc": "Request a full parameter dump (spec §12.2).",
      "fields": [
        { "index": 0, "name": "target_sys",  "type": "u8" },
        { "index": 1, "name": "target_comp", "type": "u8" }
      ]
    },
    {
      "msgid": 12289, "name": "PARAM_REQUEST_READ",
      "doc": "Request one parameter by name (index=-1) or by index (spec §12.2).",
      "fields": [
        { "index": 0, "name": "target_sys",  "type": "u8" },
        { "index": 1, "name": "target_comp", "type": "u8" },
        { "index": 2, "name": "param_id",    "type": "char", "len": 16 },
        { "index": 3, "name": "index",       "type": "i16", "doc": "-1 = use param_id" }
      ]
    },
    {
      "msgid": 12290, "name": "PARAM_VALUE",
      "doc": "Typed parameter value (spec §12.2). 'value' is the real type, never a float bit-cast.",
      "fields": [
        { "index": 0, "name": "param_id",   "type": "char", "len": 16 },
        { "index": 1, "name": "index",      "type": "u16" },
        { "index": 2, "name": "count",      "type": "u16" },
        { "index": 3, "name": "generation", "type": "u32", "doc": "bumped on every PARAM_SET" },
        { "index": 4, "name": "type",       "type": "u8",  "enum": "param_type" },
        { "index": 5, "name": "value",      "type": "u8",  "len": 8, "doc": "real value, LE, in 'type', <=8 B" }
      ]
    },
    {
      "msgid": 12291, "name": "PARAM_SET",
      "doc": "Write one parameter; answered by the updated PARAM_VALUE (spec §12.2).",
      "fields": [
        { "index": 0, "name": "target_sys",  "type": "u8" },
        { "index": 1, "name": "target_comp", "type": "u8" },
        { "index": 2, "name": "param_id",    "type": "char", "len": 16 },
        { "index": 3, "name": "type",        "type": "u8", "enum": "param_type" },
        { "index": 4, "name": "value",       "type": "u8", "len": 8 }
      ]
    },
    {
      "msgid": 12320, "name": "CALIBRATION_STATUS", "replaces": "0x6/0x01",
      "doc": "IMU calibration progress + operator instruction. Drives the GCS calibration wizard (spec §14.8).",
      "fields": [
        { "index": 0, "name": "step",     "type": "u8",  "enum": "calib_step" },
        { "index": 1, "name": "progress", "type": "u8",  "doc": "0..100 percent, for the PROGRESS step" },
        { "index": 2, "name": "coverage", "type": "f32", "len": 3, "doc": "mag axis coverage x/y/z for MAG_AXIS_COVERAGE; 0 otherwise" }
      ]
    }
  ]

        { "name": "DENIED",               "value": 2 },
        { "name": "UNSUPPORTED",          "value": 3 },
        { "name": "FAILED",               "value": 4 },
        { "name": "IN_PROGRESS",          "value": 5 }
      ]
    },
    "time_sync_role": {
      "doc": "TIME_SYNC.role (spec §10).",
      "entries": [
        { "name": "REQUEST",  "value": 0 },
        { "name": "RESPONSE", "value": 1 }
      ]
    },
    "param_type": {
      "doc": "PARAM_VALUE.type / PARAM_SET.type (spec §17).",
      "entries": [
        { "name": "U8",  "value": 1 },  { "name": "I8",  "value": 2 },
        { "name": "U16", "value": 3 },  { "name": "I16", "value": 4 },
        { "name": "U32", "value": 5 },  { "name": "I32", "value": 6 },
        { "name": "U64", "value": 7 },  { "name": "I64", "value": 8 },
        { "name": "F32", "value": 9 },  { "name": "F64", "value": 10 }
      ]
    },
    "sec_mode": {
      "doc": "CAPABILITIES.sec_modes bitmask (spec §17).",
      "entries": [

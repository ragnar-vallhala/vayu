build*/
.cache
compile_commands.json
logs
.vscode
.venv
__pycache__
build_vsim/
.sessions
# Docker (tools/docker) out-of-tree build dirs

# sim world / vehicle assets + tuner run artifacts (not source)
*.vveh
*.vworld
*.glb
tools/autotune/*.json

# Autotuner --apply writes the canonical tune here (generated artifact)
tuned_pid.json

# GCS settings store (generated at runtime, machine-local)
vayu_settings.dat

# Generated roadmap doc PDFs + LaTeX build artifacts (.tex sources are tracked)
**/*.pdf
**/*.aux
**/*.log
**/*.out
**/*.toc
**/*.fls
**/*.fdb_latexmk
**/*.synctex.gz


# Generated sim vehicle geometry (tools/autotune/plant_sweep.py builds these
# from a .vveh; the .vveh itself is already ignored).
*.geom

!firmware/docs/reference/datasheet/*.pdf
!firmware/docs/journal/log-analysis/**/*.pdf

# Unpacked firmware SITL SDK release (an artifact, never committed)
/vayu-sitl-sdk/

// Nucleo-F401RE platform for the vayu firmware, layered on top of
// Renode's stock STM32F4 SoC description.
//
// Differences from the generic stm32f4.repl:
//   - SRAM trimmed from 256 KB -> 96 KB     (F401RE = 96 KB SRAM)
//   - Flash trimmed from 2 MB  -> 512 KB    (F401RE = 512 KB)
//   - Adds USART6  (vayu's iBus RC input on rc_ibus_task)
//   - Adds DWT     (hal_cycle_counter_*, used for dt timing)
//   (RCC and CRC are already in the base stm32f4.repl.)
//
// Nothing here implements the BMX160 IMU or the four ESCs — those are
// bridged out in phase 4 of the sim plan.

using "platforms/cpus/stm32f4.repl"

sram:
    size: 0x18000

flash:
    size: 0x80000

// USART6 mock: handles register accesses AND impersonates the
// USART6-RX -> DMA2 stream 2 path that Renode's STM32_UART doesn't
// drive. Reads bytes from /tmp/vayu_usart6.fifo (host-side) at every
// time-source sync point, copies them into the firmware's ibus_dma_buf
// at the M0AR vayu programmed into DMA2 stream 2, and updates NDTR.
// The firmware's hal_uart_init_dma_rx + circular DMA + ibus_parse_byte
// code path runs unchanged — same as on real hardware against the
// FS-iA6B.
usart6: Python.PythonPeripheral @ sysbus 0x40011400
    size: 0x100
    initable: true
    filename: "/home/ragnar/Documents/Drone/vayu/tools/sim_renode/usart6_mock.py"

// Phase 5 Light: IMU sample injection. Exposes the latest
// bmx160_all_reading_t (76 bytes) from /tmp/vayu_imu.fifo. vayu's
// sim build (src/sensor/bmx160_sim.c) memcpys from this address
// every millisecond and pushes through imu_buffer / imu_queue_control
// / imu_queue_telemetry. Parked at I2C2's address - vayu uses I2C1
// only, so this slot is free.
imu_inject: Python.PythonPeripheral @ sysbus 0x40002400
    size: 0x80
    initable: true
    filename: "/home/ragnar/Documents/Drone/vayu/tools/sim_renode/imu_inject_mock.py"

// Phase 4b: motor PWM extract is registered from vayu.resc, after
// the platform loads, because Renode REPL doesn't allow redeclaring
// the inherited `timer1` from platforms/cpus/stm32f4.repl.

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 84000000

// Custom Python SDIO + SD-card mock.
//
// Renode's stock SD.STM32FSDMMC leaves the DMA's PFCTRL/PBURST/MBURST
// as unhandled and never raises the DMA transfer-complete signal that
// NavHAL's hal_sdio_wait_sync polls — so the firmware's DMA-driven
// FatFS reads hang in sim. This peripheral takes over the SDIO state
// machine AND fakes the DMA: on CMD17/CMD24 with DCTRL.DTEN+DMAEN, it
// reads/writes the block to the backing image file, writes the bytes
// directly into RAM at the firmware's programmed M0AR, and fires
// DMA2_Stream3_IRQn via the NVIC ISPR. Vayu's real DMA ISR runs from
// the right vector — same code paths as on metal.
//
// The backing image is /tmp/vayu_sd.img by default (overridable via
// VAYU_SD_PATH in the environment). It's also still attached as a
// Renode SD card object via `machine SdCardFromFile` in the .resc;
// that call is harmless here because the Python peripheral doesn't
// look at it, but it documents the host-side file.
sdio: Python.PythonPeripheral @ sysbus 0x40012c00
    size: 0x400
    initable: true
    filename: "/home/ragnar/Documents/Drone/vayu/tools/sim_renode/sdmmc_mock.py"

<?xml version="1.0" ?>
<!--
  Multicopter motor plugin demo

  Send commands to go straight up:

      gz topic -t /X3/gazebo/command/motor_speed --msgtype gz.msgs.Actuators -p 'velocity:[700, 700, 700, 700]'

  And to turn off propellers:

      gz topic -t /X3/gazebo/command/motor_speed --msgtype gz.msgs.Actuators -p 'velocity:[0, 0, 0, 0]'

-->
<sdf version="1.6">
  <world name="vayu_quad_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <!-- bullet-featherstone is preferred for multirotors. Harmonic's
         default dartsim has been observed to hit an internal abort()
         in ODE's collision detector when a multirotor with multiple
         revolute rotor joints is stepped (dDebug -> abort()), even
         on the reference quadcopter.sdf in this install. -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>

    <!-- Force-application escape hatch. The bridge can publish
         gz.msgs.EntityWrench messages on
         /world/vayu_quad_world/wrench/persistent to push the X3
         directly, in case MulticopterMotorModel + the active physics
         engine isn't applying rotor forces. -->
    <plugin
      filename="gz-sim-apply-link-wrench-system"
      name="gz::sim::systems::ApplyLinkWrench">
    </plugin>


    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <!-- X3 UAV Config 1 ships with IMU + Magnetometer + AirPressure
           sensors attached to base_link. The base X3 UAV used by the
           reference quadcopter.sdf has rotors but no onboard sensors,
           which would leave the SITL's IMU + mag streams empty. -->
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV Config 1
      </uri>
      <!-- Spawn elevated so the landing-skid model below has room to
           hang under the airframe and settle on the ground first. The
           skid is wider than the rotor footprint, so when the drone
           is at rest the contact is a stable 0.7 m square instead of
           four narrow points on the rotor housings (the X3 ships
           without landing gear and tips over from any disturbance on
           the bare rotor cylinders). -->
      <pose>0 0 0.6 0 0 0</pose>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_0_joint</jointName>
        <linkName>X3/rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1200.0</maxRotVelocity>
        <motorConstant>0.0</motorConstant>
        <momentConstant>0.0</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>0</actuator_number>
        <rotorDragCoefficient>0.0</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_1_joint</jointName>
        <linkName>X3/rotor_1</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1200.0</maxRotVelocity>
        <motorConstant>0.0</motorConstant>
        <momentConstant>0.0</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>1</actuator_number>
        <rotorDragCoefficient>0.0</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_2_joint</jointName>
        <linkName>X3/rotor_2</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1200.0</maxRotVelocity>
        <motorConstant>0.0</motorConstant>
        <momentConstant>0.0</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>2</actuator_number>
        <rotorDragCoefficient>0.0</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_3_joint</jointName>
        <linkName>X3/rotor_3</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1200.0</maxRotVelocity>
        <motorConstant>0.0</motorConstant>
        <momentConstant>0.0</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>3</actuator_number>
        <rotorDragCoefficient>0.0</rotorDragCoefficient>
        <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
    </include>

    <!-- Landing skid: a flat plate 0.7 m square slung below the X3's
         base_link. The skid is wider than the rotor footprint (~0.26 m
         x 0.44 m), so the four rotor housings never form the ground
         contact - the flat skid does, on its full perimeter. Without
         this, the X3 sits on four small rotor cylinders arranged in a
         narrow rectangle: a 4-point contact whose CG is high relative
         to its base, statically unstable, and any small motor-mix
         asymmetry or throttle change tips it (see telemetry around
         idx 2010-2030 in /tmp/vayu_uart2.log from the May 25 run).

         Mass is small (0.05 kg) so the skid does not perturb the X3's
         inertia tensor that the PID gains are tuned for.

         Welded to X3::base_link by the DetachableJoint plugin defined
         on the skid model itself - see plugin block below. -->
    <model name="vayu_skid">
      <pose>0 0 0.40 0 0 0</pose>
      <link name="skid">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.002</ixx><iyy>0.002</iyy><izz>0.004</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="skid_plate">
          <geometry>
            <box><size>0.70 0.70 0.02</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="skid_plate_vis">
          <geometry>
            <box><size>0.70 0.70 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
      <!-- DetachableJoint welds this skid to X3::base_link at runtime.
           SDF's world-level <joint> can't reference links inside an
           <include>'d Fuel model (the included model's frame names
           aren't visible to the world-level frame graph), so we use
           the DetachableJoint system plugin instead - it sets up the
           same fixed joint at simulation start time, after both
           models are spawned. The detach topic is unused (we never
           call it); the joint stays welded for the entire run. -->
      <plugin
          filename="gz-sim-detachable-joint-system"
          name="gz::sim::systems::DetachableJoint">
        <parent_link>skid</parent_link>
        <child_model>X3</child_model>
        <child_link>base_link</child_link>
        <topic>/vayu/skid/detach</topic>
      </plugin>
    </model>
  </world>
</sdf>
